# =============================================================================
# Logoped Topish — muhit o'zgaruvchilari
#
# Bu faylni `.env` nomi bilan nusxalab, qiymatlarni to'ldiring:
#     cp .env.example .env
#
# EXPO_PUBLIC_ prefiksi majburiy: faqat shunday o'zgaruvchilar ilova kodiga
# tushadi. DIQQAT: ular ilova paketiga ochiq holda kiradi, shuning uchun
# bu yerga faqat ommaviy (anon / public) kalitlar yoziladi.
# =============================================================================

# --- Yandex Maps JS API ------------------------------------------------------
# Kalit olish: https://developer.tech.yandex.ru/services (JavaScript API va
# Geocoder uchun kalit tanlanadi). Kalit bo'lmasa ilova ishlaydi, lekin
# "Harita" bo'limi o'rniga tushuntirish ko'rsatiladi.
EXPO_PUBLIC_YANDEX_MAPS_API_KEY=

# Harita yorliqlari tili. Yandex JS API cheklangan tillarni qo'llab-quvvatlaydi,
# standart qiymat — ru_RU (O'zbekiston uchun eng to'liq qamrov).
# EXPO_PUBLIC_YANDEX_MAPS_LANG=ru_RU

# --- Supabase ----------------------------------------------------------------
# Supabase panelidan: Project Settings -> API
# Kalitlar bo'lmasa ilova `src/data/fallback-centers.ts` dagi demo ro'yxatni
# ko'rsatadi va "Sozlamalar"da demo rejimni belgilaydi.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
